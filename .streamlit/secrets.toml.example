# 이 파일은 예시(템플릿)입니다. 실제 값을 채운 뒤 파일명을
# secrets.toml 로 바꾸어 이 폴더의 .streamlit/ 안에 두면 "로컬"에서 테스트할 수 있습니다.
#
# ⚠️ 절대로 실제 값이 채워진 secrets.toml 파일을 GitHub 저장소에 커밋(업로드)하지 마세요.
#    (.gitignore 에 이미 제외 처리가 되어 있습니다.)
#
# Streamlit Community Cloud에 배포한 경우에는 이 파일 대신
# 앱 관리 화면(Manage app) > Settings > Secrets 에 아래 내용을 그대로 붙여넣으면 됩니다.
#
# 값을 채우는 방법은 GOOGLE_SHEETS_설정가이드.md 를 참고하세요.

[connections.gsheets]
spreadsheet = "여기에 구글 스프레드시트 공유 URL을 붙여넣으세요 (예: https://docs.google.com/spreadsheets/d/xxxxxxxx/edit)"
type = "service_account"
project_id = "여기에 서비스 계정 JSON의 project_id 값"
private_key_id = "여기에 서비스 계정 JSON의 private_key_id 값"
private_key = "-----BEGIN PRIVATE KEY-----\n여기에 서비스 계정 JSON의 private_key 값 전체\n-----END PRIVATE KEY-----\n"
client_email = "여기에 서비스 계정 JSON의 client_email 값 (예: xxxx@xxxx.iam.gserviceaccount.com)"
client_id = "여기에 서비스 계정 JSON의 client_id 값"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "여기에 서비스 계정 JSON의 client_x509_cert_url 값"
