# 이 파일은 예시(템플릿)입니다. 실제 값을 채운 뒤 파일명을
# secrets.toml 로 바꾸어 이 폴더의 .streamlit/ 안에 두면 "로컬"에서 테스트할 수 있습니다.
#
# ⚠️ 절대로 실제 값이 채워진 secrets.toml 파일을 GitHub 저장소에 커밋(업로드)하지 마세요.
#    (.gitignore 에 이미 제외 처리가 되어 있습니다.)
#
# Streamlit Community Cloud에 배포한 경우에는 이 파일 대신
# 앱 관리 화면(Manage app) > Settings > Secrets 에 아래 내용을 그대로 붙여넣으면 됩니다.
#
# 값을 채우는 방법은 SUPABASE_설정가이드.md 를 참고하세요.

[supabase]
url = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
key = "여기에 Supabase 프로젝트의 service_role 키를 붙여넣으세요 (Project Settings > API)"
